root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ktlint_code_style = ktlint_official
ktlint_standard_no-wildcard-imports = enabled
# Nama berkas mengikuti struktur package di CLAUDE.md (Application.kt, Database.kt,
# XxxRoutes/Service/Repository/Dto), bukan nama deklarasi tunggal di dalamnya.
ktlint_standard_filename = disabled
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{yml,yaml,json}]
indent_size = 2

[*.sql]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
