# Salin ke .env untuk pengembangan lokal. Jangan pernah commit .env.
# Di staging/produksi semua nilai ini datang dari secret manager.

APP_ENV=dev

# Port host untuk container Postgres (docker-compose). Ubah bila 5432 sudah dipakai
# Postgres lain di mesin ini, lalu samakan DATABASE_URL di bawah.
DB_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/pwl
DATABASE_USER=pwl
DATABASE_PASSWORD=pwl
DATABASE_POOL_SIZE=10

# Acak 256-bit. Penandatangan access token.
JWT_SECRET=ganti-dengan-nilai-acak-256-bit

# Acak 256-bit. Kunci HMAC untuk staff.pin_lookup — TIDAK PERNAH disimpan di database,
# dan mengubahnya membuat semua PIN lama tidak bisa ditemukan (perlu reset PIN massal).
PIN_PEPPER=ganti-dengan-nilai-acak-256-bit

# Versi aplikasi Android minimum; di bawah ini server menjawab 426 APP_UPDATE_REQUIRED.
MIN_APP_VERSION=0.0.0

# Jalankan migrasi Flyway saat API boot. Default: true di dev, false di staging/prod — di sana
# migrasi adalah job pre-deploy (bin/pwl-migrate) yang berjalan sebagai pwl_migrator.
# RUN_MIGRATIONS_ON_BOOT=true

# ---------------------------------------------------------------------------
# WhatsApp Cloud API — fase terakhir (M5), lihat README "Integrasi Meta / WhatsApp".
# API dan test M1–M4 harus tetap jalan tanpa variabel ini; hanya proses worker yang memerlukannya.
# ---------------------------------------------------------------------------
# WA_ACCESS_TOKEN=
# WA_PHONE_NUMBER_ID=
# WA_APP_SECRET=
# WA_VERIFY_TOKEN=
